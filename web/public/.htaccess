# ==============================================================================
# Prime Cuts - Frontend .htaccess for cPanel / LiteSpeed / Apache
# Preserves /api requests for Node.js / Passenger & handles SPA routing
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. CRITICAL: Never rewrite /api requests to index.html
  # Pass directly to Node.js backend (cPanel Phusion Passenger / Reverse Proxy)
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [L]

  # 1b. If an uploaded image does not exist locally in frontend, route it to backend API uploads
  RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^uploads/(.*)$ /api/uploads/$1 [L]

  # 2. Serve actual physical files & directories directly (CSS, JS, images, icons, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback all remaining browser navigation routes to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Browser Caching Rules
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Never cache Service Worker or Web Manifest so mobile PWA push updates immediately
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.json|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Allow Google OAuth Sign-In popup communication on cPanel Apache / LiteSpeed
  <FilesMatch "\.(html)$">
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  </FilesMatch>

  # Security & CORS Headers for Assets
  <FilesMatch "\.(ico|jpe?g|png|gif|svg|webp|woff2?|css|js)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
